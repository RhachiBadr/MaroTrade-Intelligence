# ════════════════════════════════════════════════════════════════════════════
# MaroTrade Intelligence — Configuration Docker EXEMPLE
# ════════════════════════════════════════════════════════════════════════════
# COPIER CE FICHIER EN .env ET ADAPTER LES VALEURS

# ─────────────────────────────────────────────────────────────────────────────
# 🗂️ DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Utilisateur PostgreSQL (par défaut: postgres)
POSTGRES_USER=postgres

# Mot de passe PostgreSQL (⚠️ À CHANGER en production!)
POSTGRES_PASSWORD=postgrespassword

# Base de données
POSTGRES_DB=marotrade_db

# URL connexion complète (généré automatiquement par docker-compose)
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/marotrade_db?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# 🔴 REDIS (Cache)
# ─────────────────────────────────────────────────────────────────────────────

# Host Redis (depuis Docker: "redis", depuis local: "localhost")
REDIS_HOST=redis

# Port Redis
REDIS_PORT=6379

# DB Redis (0-15, par défaut 0)
REDIS_DB=0

# Mot de passe Redis (vide par défaut)
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 🌍 EXTERNAL APIs (Gratuits/Optionnels)
# ─────────────────────────────────────────────────────────────────────────────

# UN Comtrade API Key (Gratuit - laisser vide si non utilisé)
# Docs: https://comtradeapi.un.org/docs
COMTRADE_API_KEY=

# ITC Trade Map API Key (Gratuit)
# Docs: https://www.trademap.org/
ITC_API_KEY=

# Freightos API Key (Payant - optionnel)
# Docs: https://freightos.com/api
FREIGHTOS_API_KEY=

# Anthropic Claude API Key (Payant - optionnel)
# Pour LLM analysis. Docs: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 🎨 PGADMIN (Administration PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Email de connexion PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@marotrade.ma

# Mot de passe PgAdmin (⚠️ À CHANGER!)
PGADMIN_DEFAULT_PASSWORD=adminpassword

# ─────────────────────────────────────────────────────────────────────────────
# 📊 APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# App Name
APP_NAME=MaroTrade Intelligence

# App Version
APP_VERSION=2.0

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Environment (development, staging, production)
ENVIRONMENT=docker

# ─────────────────────────────────────────────────────────────────────────────
# 🌍 LOCALE & TIMEZONE
# ─────────────────────────────────────────────────────────────────────────────

# Timezone (pour tous les conteneurs)
TZ=Africa/Casablanca

# Language
LANG=fr_FR.UTF-8

# ····························────────────────────────────────────────────────····
# COMMANDES DE DÉMARRAGE
# ─────────────────────────────────────────────────────────────────────────────

# Mode DÉVELOPPEMENT (léger):
#   cd docker
#   docker-compose -f docker-compose.dev.yml --env-file .env up -d

# Mode PRODUCTION (complet):
#   cd docker
#   docker-compose --env-file .env up -d

# Arrêter:
#   docker-compose down

# ⚠️  SÉCURITÉ — PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────

# 1. CHANGER TOUS LES MOTS DE PASSE (voir POSTGRES_PASSWORD, PGADMIN_DEFAULT_PASSWORD)
# 2. AJOUTER REDIS_PASSWORD si nécessaire
# 3. CONFIGURER FIREWALL pour limiter accès aux ports
# 4. UTILISER HTTPS/TLS avec certificats valides
# 5. MONITORER les logs pour les anomalies
# 6. FAIRE DES BACKUPS RÉGULIERS

# ════════════════════════════════════════════════════════════════════════════