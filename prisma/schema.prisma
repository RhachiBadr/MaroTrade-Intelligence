// ═══════════════════════════════════════════════════════════════
// schema.prisma — MaroTrade Intelligence
// Base de données PostgreSQL complète
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum AlertLevel {
  CRITIQUE
  ATTENTION
  INFO
}

enum AccordType {
  ALE       // Accord de libre-échange (droits 0%)
  PREF      // Accord préférentiel (droits réduits)
  NPF       // Nation la plus favorisée (droits standard)
  DOM       // Marché domestique
}

enum MarketTrend {
  FORTE_CROISSANCE
  CROISSANCE_STABLE
  CROISSANCE_MODEREE
  STAGNATION
  DECLIN
}

enum GrowthLabel {
  FUSEE
  FORT
  STABLE
  LENT
  DECLIN
}

enum UserRole {
  PME           // PME exportatrice
  AGENT_PORT    // Agent portuaire / douanier
  ADMIN         // Administrateur plateforme
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProjectPipelineStage {
  PROSPECTION
  NEGOTIATION
  COMMANDE
  EXPEDITION
  LIVRAISON
}

// ═══════════════════════════════════════════════════════════════
// UTILISATEURS
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  company       String?   // Nom de l'entreprise PME
  role          UserRole  @default(PME)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations existantes
  analyses           Analysis[]
  savedMarkets       SavedMarket[]
  alertSubscriptions AlertSubscription[]

  // Nouvelles relations (Extensions)
  readinessScore     ExportReadinessScore?
  simulations        ProfitabilitySimulation[]
  exportProjects     ExportProject[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// PRODUITS & CODES HS
// ═══════════════════════════════════════════════════════════════

model Product {
  id          String   @id @default(cuid())
  hsCode      String   @unique  // "151590", "09102010", etc.
  hsCode6     String            // 6 premiers chiffres (famille)
  name        String            // "Huile d'argan bio"
  nameAr      String?           // Nom en arabe
  category    String            // "Agroalimentaire", "Artisanat", etc.
  sector      String            // "Terroir", "Textile", "Industrie"
  description String?
  emoji       String?           // "🫒", "🌺", etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations existantes
  analyses        Analysis[]
  tradeData       TradeData[]
  historicalData  HistoricalTradeData[]
  forecasts       MarketForecastData[]
  growthMetrics   GrowthMetric[]

  // Nouvelles relations (Extensions)
  simulations     ProfitabilitySimulation[]
  b2bBuyers       B2bBuyer[]
  exportProjects  ExportProject[]
  competitorPrices CompetitorPriceAlert[]

  @@index([hsCode6])
  @@index([category])
  @@map("products")
}

// ═══════════════════════════════════════════════════════════════
// PAYS
// ═══════════════════════════════════════════════════════════════

model Country {
  id          String  @id @default(cuid())
  isoCode     String  @unique  // "FRA", "USA", "JPN"
  isoCode2    String  @unique  // "FR", "US", "JP"
  name        String           // "France"
  nameAr      String?          // "فرنسا"
  flag        String?          // "🇫🇷"
  region      String           // "Europe", "Amérique du Nord", "Golfe"

  // Accord commercial Maroc
  accordLabel   String         
  accordType    AccordType     
  droitsDouane  Float          

  // Indicateurs World Bank
  easeBusiness      Float      
  politicalStability Float     
  ruleOfLaw         Float      
  regulatoryQuality Float      
  wbUpdatedAt       DateTime?  

  // Risque pays OCDE
  ocdeRiskCategory  Int        
  ocdeRiskScore     Float      
  ocdeRiskLabel     String     
  ocdeUpdatedAt     DateTime?

  // Logistique
  distanceKm         Int       
  lpi                Float     
  coutConteneur      Int       
  portPrincipal      String?   
  freightLive        Boolean   @default(false)

  // Diaspora MRE
  diasporaPopulation Int       @default(0)   
  diasporaTransferts Float     @default(0)   

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations existantes
  scoringResults    ScoringResult[]
  tradeData         TradeData[]
  historicalData    HistoricalTradeData[]
  forecasts         MarketForecastData[]
  growthMetrics     GrowthMetric[]
  alertCountries    RegulatoryAlertCountry[]
  savedMarkets      SavedMarket[]
  alertSubscriptions AlertSubscription[]

  // Nouvelles relations (Extensions)
  simulations     ProfitabilitySimulation[]
  b2bBuyers       B2bBuyer[]
  exportProjects  ExportProject[]

  @@index([region])
  @@index([accordType])
  @@map("countries")
}

// ═══════════════════════════════════════════════════════════════
// ANALYSES
// ═══════════════════════════════════════════════════════════════

model Analysis {
  id          String         @id @default(cuid())
  userId      String?
  productId   String
  productName String         // Nom saisi par l'utilisateur
  hsCode      String         // Code HS utilisé
  topN        Int            @default(5)
  status      AnalysisStatus @default(PENDING)
  durationMs  Int?           // Durée d'exécution en ms
  errorMessage String?

  weightMarche    Float  @default(0.28)
  weightAccord    Float  @default(0.22)
  weightBusiness  Float  @default(0.18)
  weightStabilite Float  @default(0.12)
  weightDiaspora  Float  @default(0.10)
  weightLogistique Float @default(0.10)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  results       ScoringResult[]

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
  @@map("analyses")
}

model ScoringResult {
  id          String  @id @default(cuid())
  analysisId  String
  countryId   String
  rank        Int            

  scoreFinal    Float        
  scoreWeighted Float        
  scoreXgboost  Float        

  shapValues    Json
  topAtouts   String[]       
  topRisques  String[]       

  createdAt   DateTime @default(now())

  analysis     Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  country      Country   @relation(fields: [countryId], references: [id])
  dimensions   DimensionScoreData[]

  @@unique([analysisId, countryId])
  @@index([analysisId])
  @@index([scoreFinal])
  @@map("scoring_results")
}

model DimensionScoreData {
  id              String  @id @default(cuid())
  scoringResultId String
  nom             String  
  score           Float   
  poids           Float   
  contribution    Float   
  detail          Json    
  interpretation  String  

  scoringResult ScoringResult @relation(fields: [scoringResultId], references: [id], onDelete: Cascade)

  @@index([scoringResultId])
  @@map("dimension_scores")
}

// ═══════════════════════════════════════════════════════════════
// DONNÉES COMMERCIALES & PRÉVISIONS
// ═══════════════════════════════════════════════════════════════

model TradeData {
  id          String   @id @default(cuid())
  productId   String
  countryId   String
  year        Int      
  valueUsd    Float    
  weightKg    Float    
  priceUsdKg  Float    
  source      String   @default("UN_COMTRADE")  
  fetchedAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([productId, countryId, year])
  @@index([productId, year])
  @@map("trade_data")
}

model HistoricalTradeData {
  id          String  @id @default(cuid())
  productId   String
  countryId   String
  year        Int     
  valueUsd    Float   
  source      String  @default("UN_COMTRADE")

  product Product @relation(fields: [productId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([productId, countryId, year])
  @@index([productId, countryId])
  @@map("historical_trade_data")
}

model GrowthMetric {
  id          String   @id @default(cuid())
  productId   String
  countryId   String
  cagr        Float    
  velocity    Float    
  momentum    Float    
  label       GrowthLabel  
  interpretation String    
  computedAt  DateTime @default(now())
  sourceYears String   @default("2020-2022") 

  product Product @relation(fields: [productId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([productId, countryId])
  @@index([productId])
  @@map("growth_metrics")
}

model MarketForecastData {
  id          String   @id @default(cuid())
  productId   String
  countryId   String

  historicalValues Json  
  historicalYears  Json  

  forecastValues  Json   
  forecastYears   Json   
  lowerBound      Json   
  upperBound      Json   

  cagrHistorique  Float  
  cagrPrevu       Float  
  acceleration    Float  
  scoreFutur      Float  
  tendance        MarketTrend
  confiance       Float  
  valeur2022      Float  
  valeur2026      Float  

  modelVersion    String   @default("prophet-1.1")
  computedAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([productId, countryId])
  @@index([productId])
  @@index([scoreFutur])
  @@map("market_forecasts")
}

// ═══════════════════════════════════════════════════════════════
// ALERTES RÉGLEMENTAIRES
// ═══════════════════════════════════════════════════════════════

model RegulatoryAlert {
  id            String      @id @default(cuid())
  externalId    String?     @unique  
  titre         String
  titreFr       String      
  niveau        AlertLevel
  source        String      
  sourceUrl     String?     

  produitsHs    String[]    
  produitsNoms  String[]    

  resumeFr      String      
  impactExport  String      
  actionRequise String      
  dateVigueur   DateTime?   
  datePublication DateTime?

  impactScore   Float       
  sourceFilable Boolean     @default(true)
  llmConfiance  Float?      
  llmEnhanced   Boolean     @default(false)  

  delaiJours    Int?

  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  countries     RegulatoryAlertCountry[]
  subscriptions AlertSubscription[]

  @@index([niveau])
  @@index([impactScore])
  @@index([dateVigueur])
  @@map("regulatory_alerts")
}

model RegulatoryAlertCountry {
  alertId     String
  countryId   String

  alert   RegulatoryAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  country Country         @relation(fields: [countryId], references: [id])

  @@id([alertId, countryId])
  @@map("regulatory_alert_countries")
}

model AlertSubscription {
  id        String   @id @default(cuid())
  userId    String
  countryId String?  
  hsCode    String?  
  minLevel  AlertLevel @default(ATTENTION) 
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country?        @relation(fields: [countryId], references: [id])
  alerts  RegulatoryAlert[] 

  @@unique([userId, countryId, hsCode])
  @@map("alert_subscriptions")
}

model SavedMarket {
  id        String   @id @default(cuid())
  userId    String
  countryId String
  hsCode    String   
  notes     String?  
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@unique([userId, countryId, hsCode])
  @@map("saved_markets")
}

model ApiCache {
  id         String   @id @default(cuid())
  cacheKey   String   @unique  
  source     String            
  payload    Json              
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime          

  @@index([expiresAt])
  @@index([source])
  @@map("api_cache")
}

// ═══════════════════════════════════════════════════════════════
// NORMALISATION PORTUAIRE (Module C01 — IMO Compendium)
// ═══════════════════════════════════════════════════════════════

model Port {
  id          String  @id @default(cuid())
  unlocode    String  @unique  
  name        String           
  countryCode String           
  isActive    Boolean @default(true)

  escales     Escale[]

  @@map("ports")
}

model Escale {
  id              String   @id @default(cuid())
  portId          String
  navireNom       String
  navireImo       String?  
  dateArrivee     DateTime
  dateDepart      DateTime?
  statut          String   

  imoDataRaw      Json?    
  imoDataNorm     Json?    
  validationErrors String[] 
  isNormalized    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  port Port @relation(fields: [portId], references: [id])
  manifestes Manifeste[]

  @@index([portId])
  @@index([dateArrivee])
  @@map("escales")
}

model Manifeste {
  id          String   @id @default(cuid())
  escaleId    String
  hsCode      String   
  description String
  poidsKg     Float
  valeurUsd   Float
  exportateur String?
  paysDest    String?  

  imoCodeMarchandise String?  
  isValide           Boolean  @default(false)

  createdAt DateTime @default(now())

  escale Escale @relation(fields: [escaleId], references: [id], onDelete: Cascade)

  @@index([escaleId])
  @@index([hsCode])
  @@map("manifestes")
}

// ═══════════════════════════════════════════════════════════════
// 1. MODULE EXPORT READINESS SCORE
// ═══════════════════════════════════════════════════════════════

model ExportReadinessScore {
  id                  String   @id @default(cuid())
  userId              String   @unique
  scoreTotal          Float    // 0-100
  
  // Dimensions
  certificationsScore Float?
  capaciteProduction  Float?
  packagingNormes     Float?
  tracabilite         Float?
  
  // Plan d'action : "ce qui manque pour exporter"
  actionPlan          Json?    
  lastEvaluatedAt     DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("export_readiness_scores")
}

// ═══════════════════════════════════════════════════════════════
// 2. SIMULATEUR DE RENTABILITÉ EXPORT
// ═══════════════════════════════════════════════════════════════

model ProfitabilitySimulation {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  countryId      String

  // Entrées
  prixVenteCible Float    // Prix de vente estimé sur le marché (ex: EUR)
  coutProduction Float    // Coût de revient usine
  volumeEstime   Float    // Volume projeté
  
  // Sorties calculées
  coutFret       Float?   // Fret estimé
  droitsDouane   Float?   // Droits à l'arrivée (calculés via l'Accord)
  fraisCertif    Float?   // Frais de certification
  margeNette     Float?   // Marge finale
  roi            Float?   // Return On Investment (%)

  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  country        Country  @relation(fields: [countryId], references: [id])

  @@map("profitability_simulations")
}

// ═══════════════════════════════════════════════════════════════
// 3. ACHETEURS POTENTIELS B2B
// ═══════════════════════════════════════════════════════════════

model B2bBuyer {
  id               String   @id @default(cuid())
  countryId        String
  productId        String
  
  companyName      String
  contactName      String?
  email            String?
  phone            String?
  website          String?
  
  platformSource   String?  // Ex: "Kompass", "Europages"
  credibilityScore Float?   // Fiabilité (0-100)

  createdAt        DateTime @default(now())

  country          Country  @relation(fields: [countryId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])
  
  @@index([countryId, productId])
  @@map("b2b_buyers")
}

// ═══════════════════════════════════════════════════════════════
// 4. TRACKER DE DOSSIER EXPORT (PIPELINE KANBAN)
// ═══════════════════════════════════════════════════════════════

model ExportProject {
  id              String   @id @default(cuid())
  userId          String
  countryId       String
  productId       String
  
  name            String
  stage           ProjectPipelineStage @default(PROSPECTION)
  
  targetVolume    Float?
  expectedRevenue Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  country         Country      @relation(fields: [countryId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
  tasks           ExportTask[]

  @@map("export_projects")
}

model ExportTask {
  id               String   @id @default(cuid())
  projectId        String
  title            String
  description      String?
  dueDate          DateTime?
  isCompleted      Boolean  @default(false)
  
  documentRequired String?  // Ex: "Certificat d'origine", "Phytosanitaire"

  createdAt        DateTime @default(now())

  project          ExportProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("export_tasks")
}

// ═══════════════════════════════════════════════════════════════
// 5. VEILLE CONCURRENTIELLE PRODUIT
// ═══════════════════════════════════════════════════════════════

model CompetitorPriceAlert {
  id                String   @id @default(cuid())
  productId         String
  competitorCountry String   // Ex: "Espagne" (pour l'huile d'olive) ou "Iran" (Safran)
  
  platform          String   // "Amazon", "Alibaba", etc.
  priceUsd          Float
  priceChangePct    Float?   // Variation % récente (ex: -12.5)
  
  url               String?
  detectedAt        DateTime @default(now())

  product           Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("competitor_prices")
}
