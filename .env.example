# MaroTrade Intelligence - Variables d'environnement
# Copiez ce fichier vers docker.env et remplissez les valeurs

# === BASE DE DONNÉES (Étape 4) ===
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/marotrade_db?schema=public

# === CACHE REDIS (Étape 4) ===
REDIS_URL=redis://localhost:6379

# === SÉCURITÉ (Étape 4) ===
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
REMEMBER_TOKEN_DAYS=30
COOKIE_SECURE=false
AUTH_EXPOSE_DEV_TOKENS=false

# === NLP REGLEMENTAIRE ===
# Charge XLM-RoBERTa seulement lors du premier appel /api/alerts.
WATCH_NLP_ENABLED=true
WATCH_NLP_LAZY_LOAD=true
NLP_LOCAL_MODEL_ENABLED=true
# BART est tres lourd. Le fallback leger par regles est utilise par defaut.
NLP_ZERO_SHOT_FALLBACK_ENABLED=false

# === APIs EXTERNES ===
# Anthropic Claude (LLM pour analyse réglementaire)
ANTHROPIC_API_KEY=sk-ant-api03-...

# UN Comtrade (données commerciales internationales)
UN_COMTRADE_API_KEY=your-un-comtrade-api-key

# World Bank (indicateurs gouvernance et économie)
WORLD_BANK_API_KEY=your-world-bank-api-key

# Google Trends (analyse tendances marché)
GOOGLE_TRENDS_API_KEY=your-google-trends-api-key

# === CONFIGURATION CACHE ===
CACHE_DIR=.cache_marotrade

# === CONFIGURATION APPLICATION ===
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout APIs externes (secondes)
API_TIMEOUT=30

# Nombre maximum de requêtes API par minute
RATE_LIMIT_REQUESTS=100

# === CONFIGURATION FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:8000
