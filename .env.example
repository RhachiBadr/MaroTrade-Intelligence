# MaroTrade Intelligence - Variables d'environnement
# Copiez ce fichier vers docker.env et remplissez les valeurs

# === BASE DE DONNÉES (Étape 4) ===
DATABASE_URL=postgresql://marotrade:password@localhost:5432/marotrade

# === CACHE REDIS (Étape 4) ===
REDIS_URL=redis://localhost:6379

# === SÉCURITÉ (Étape 4) ===
JWT_SECRET_KEY=marotrade-secret-key-change-in-production-2024

# === APIs EXTERNES ===
# Anthropic Claude (LLM pour analyse réglementaire)
ANTHROPIC_API_KEY=sk-ant-api03-...

# UN Comtrade (données commerciales internationales)
UN_COMTRADE_API_KEY=your-un-comtrade-api-key

# World Bank (indicateurs gouvernance et économie)
WORLD_BANK_API_KEY=your-world-bank-api-key

# Google Trends (analyse tendances marché)
GOOGLE_TRENDS_API_KEY=your-google-trends-api-key

# === CONFIGURATION CACHE ===
CACHE_DIR=.cache_marotrade

# === CONFIGURATION APPLICATION ===
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout APIs externes (secondes)
API_TIMEOUT=30

# Nombre maximum de requêtes API par minute
RATE_LIMIT_REQUESTS=100

# === CONFIGURATION FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:8000