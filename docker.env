# ═══════════════════════════════════════════════════════════════
# MaroTrade Intelligence — Docker Environment
# Utilisation interne au réseau Docker (service:port)
# ═══════════════════════════════════════════════════════════════

# Database
# Note: 'postgres' est le nom du service dans docker-compose.yml
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/marotrade_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=marotrade_db

# pgAdmin (Interface de gestion DB)
PGADMIN_DEFAULT_EMAIL=admin@marotrade.ma
PGADMIN_DEFAULT_PASSWORD=adminpassword

# Frontend
NEXT_PUBLIC_DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/marotrade_db?schema=public"
NODE_ENV=development
